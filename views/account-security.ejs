<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Security | ChurnIQ</title>
  <%- include('partials/auth-reset-styles') %>
  <style>
    .qr { display:block; margin:0 auto 14px; width:200px; height:200px; }
    .secret { font-family: Consolas, monospace; background:#f4f5ff; border-radius:8px; padding:10px; text-align:center; word-break:break-all; font-size:14px; margin-bottom:18px; }
    .codes { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:14px 0 18px; font-family:Consolas, monospace; font-size:15px; text-align:center; }
    .codes span { background:#f4f5ff; border-radius:8px; padding:8px; }
    .status { text-align:center; font-weight:600; margin-bottom:20px; }
    .status.on { color:#237a3b; } .status.off { color:#a93226; }
    form { margin-bottom: 14px; }
  </style>
</head>
<body>
  <main class="card">
    <h1>Account Security</h1>
    <p class="sub">Every sign-in needs a second step: a one-time code.</p>

    <% if (error && error.length > 0) { %><div class="message error-msg"><%= error[0] %></div><% } %>
    <% if (success && success.length > 0) { %><div class="message success-msg"><%= success[0] %></div><% } %>

    <% if (backupCodes) { %>
      <p class="sub"><strong>Save these backup codes now.</strong> Each works once if you lose your phone. They will not be shown again.</p>
      <div class="codes"><% backupCodes.forEach(function (c) { %><span><%= c %></span><% }) %></div>
    <% } else if (enabled) { %>
      <p class="status on">Sign-in verification: authenticator app</p>
      <form action="/account/security/disable" method="POST">
        <div class="form-group">
          <label for="code">To switch back to email codes, enter a current code or a backup code</label>
          <input id="code" type="text" name="code" autocomplete="one-time-code" maxlength="12" required />
        </div>
        <button class="btn btn-secondary" type="submit">Switch back to email codes</button>
      </form>
    <% } else if (secret) { %>
      <p class="status off">Authenticator app: scan and confirm</p>
      <% if (qrDataUrl) { %><img class="qr" src="<%= qrDataUrl %>" alt="Authenticator QR code" /><% } %>
      <p class="helper" style="text-align:center;margin-bottom:6px;">Or enter this key manually in your authenticator app:</p>
      <div class="secret"><%= secret %></div>
      <form action="/account/security/enable" method="POST">
        <div class="form-group">
          <label for="code">6-digit code from the app</label>
          <input class="otp-input" id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus />
        </div>
        <button class="btn btn-primary" type="submit">Use authenticator app</button>
      </form>
    <% } else { %>
      <p class="status on">Email verification is ON for every sign-in</p>
      <p class="helper" style="text-align:center;margin-bottom:18px;">We email a 6-digit code to <%= maskedEmail %> each time you log in.</p>
      <form action="/account/security/setup" method="POST">
        <button class="btn btn-secondary" type="submit">Use an authenticator app instead</button>
      </form>
    <% } %>

    <div class="bottom-link"><a href="/dashboard">Back to dashboard</a></div>
  </main>
</body>
</html>
