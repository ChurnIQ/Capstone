{
  "info": {
    "name": "ChurnIQ API Security – Basic Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Basic Authentication tests for the existing ChurnIQ API. Import together with ChurnIQ-Local.postman_environment.json and run the collection (Runner)."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basic_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{basic_pass}}",
        "type": "string"
      }
    ]
  },
  "variable": [],
  "item": [
    {
      "name": "1. Basic Auth checks",
      "item": [
        {
          "name": "Valid credentials → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "Collection-level Basic Auth is used."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Authenticated as the API user\", function () { pm.expect(pm.response.json().name).to.eql(pm.environment.get(\"basic_user\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Incorrect password → 401",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basic_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{wrong_pass}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Body says Unauthorized\", function () { pm.expect(pm.response.json().error).to.eql(\"Unauthorized\"); });",
                  "pm.test(\"WWW-Authenticate challenge present\", function () { pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Basic\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Incorrect username → 401",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "intruder",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{basic_pass}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Body says Unauthorized\", function () { pm.expect(pm.response.json().error).to.eql(\"Unauthorized\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing credentials → 401",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Body says Unauthorized\", function () { pm.expect(pm.response.json().error).to.eql(\"Unauthorized\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Churn prediction (POST /api/predict)",
      "item": [
        {
          "name": "Predict churn – valid credentials → 200",
          "request": {
            "method": "POST",
            "auth": null,
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"POSTMAN-{{$timestamp}}\",\n  \"customer_name\": \"Postman Demo Customer\",\n  \"age\": 35,\n  \"no_of_days_subscribed\": 120,\n  \"multi_screen\": \"No\",\n  \"mail_subscribed\": \"No\",\n  \"weekly_mins_watched\": 90,\n  \"minimum_daily_mins\": 5,\n  \"maximum_daily_mins\": 40,\n  \"weekly_max_night_mins\": 20,\n  \"videos_watched\": 12,\n  \"maximum_days_inactive\": 21,\n  \"customer_support_calls\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "predict"
              ]
            },
            "description": "Reuses the existing churn prediction endpoint (Flask Random Forest model)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json();",
                  "pm.test(\"Has churn_prediction 0 or 1\", function () { pm.expect([0,1]).to.include(r.churn_prediction); });",
                  "pm.test(\"churn_probability between 0 and 1\", function () { pm.expect(r.churn_probability).to.be.within(0,1); });",
                  "pm.test(\"risk_category is High/Medium/Low\", function () { pm.expect([\"High\",\"Medium\",\"Low\"]).to.include(r.risk_category); });",
                  "if (r._id) { pm.environment.set(\"prediction_id\", r._id); }"
                ]
              }
            }
          ]
        },
