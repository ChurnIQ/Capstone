<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | ChurnIQ</title>
  <%- include('partials/auth-reset-styles') %>
</head>
<body>
  <main class="card">
    <h1>Forgot Password?</h1>
    <p class="sub">Enter your account email and we'll send a one-time verification code.</p>

    <% if (error && error.length > 0) { %><div class="message error-msg"><%= error[0] %></div><% } %>
    <% if (success && success.length > 0) { %><div class="message success-msg"><%= success[0] %></div><% } %>

    <form action="/forgot-password" method="POST" data-loading-form>
      <div class="form-group">
        <label for="email">Email address</label>
        <input id="email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
      <button class="btn btn-primary" type="submit" data-loading-text="Sending code…">Send verification code</button>
    </form>

    <div class="bottom-link"><a href="/login">Back to sign in</a></div>
  </main>
  <script>
    document.querySelector('[data-loading-form]').addEventListener('submit', function () {
      const button = this.querySelector('button[type="submit"]');
      button.disabled = true;
      button.textContent = button.dataset.loadingText;
    });
  </script>
</body>
</html>
