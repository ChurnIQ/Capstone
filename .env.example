# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Docker:     mongodb://mongo:27017/loginpage
# Local dev:  mongodb://localhost:27017/loginpage
MONGODB_URI=mongodb://localhost:27017/loginpage

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-key-change-this
OTP_HASH_SECRET=use-a-separate-long-random-secret-in-production

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get credentials from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: http://<your-host>:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Password reset email (SMTP) ───────────────────────────────────────────────
# Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="ChurnIQ <no-reply@example.com>"

# ── Flask ML API ──────────────────────────────────────────────────────────────
# Docker:     http://ml:5000  (set automatically by compose.yaml — do not change)
# Local dev:  http://localhost:5000
ML_API_URL=http://localhost:5000
MODEL_PATH=ml/model.pkl
SCALER_PATH=ml/scaler.pkl

# ── ngrok (optional) ──────────────────────────────────────────────────────────
# Get token at: https://dashboard.ngrok.com/get-started/your-authtoken
# Usage: npm run ngrok:start / npm run ngrok:stop
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Optional: custom DNS servers if your network blocks Atlas SRV lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── API security: HTTP Basic Auth for /api (Postman / Swagger / curl) ─────────
# Required. Use a long random password in production (set in Vercel env vars too).
BASIC_AUTH_USER=churniq_api
BASIC_AUTH_PASS=change-me-to-a-long-random-password
