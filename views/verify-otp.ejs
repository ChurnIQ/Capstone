<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Code | ChurnIQ</title>
  <%- include('partials/auth-reset-styles') %>
</head>
<body>
  <main class="card">
    <h1>Verify Your Email</h1>
    <p class="sub">Enter the 6-digit code. It expires five minutes after it is sent.</p>

    <% if (error && error.length > 0) { %><div class="message error-msg"><%= error[0] %></div><% } %>
    <% if (success && success.length > 0) { %><div class="message success-msg"><%= success[0] %></div><% } %>

    <form action="/verify-otp" method="POST" data-loading-form>
      <div class="form-group">
        <label for="otp">Verification code</label>
        <input class="otp-input" id="otp" type="text" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" required autofocus />
        <p class="helper">For your security, five incorrect attempts will lock this code.</p>
      </div>
      <button class="btn btn-primary" type="submit" data-loading-text="Verifying…">Verify code</button>
    </form>

    <form action="/resend-otp" method="POST" data-loading-form>
      <button class="btn btn-secondary" id="resendButton" type="submit" data-loading-text="Sending…">Resend code</button>
    </form>

    <div class="bottom-link"><a href="/forgot-password">Use a different email</a></div>
  </main>
  <script>
    document.querySelectorAll('[data-loading-form]').forEach(function (form) {
      form.addEventListener('submit', function () {
        const button = this.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = button.dataset.loadingText;
      });
    });

    const resendAt = <%- JSON.stringify(resendAvailableAt || 0) %>;
    const resendButton = document.getElementById('resendButton');
    function updateResend() {
      const seconds = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
      if (seconds > 0) {
        resendButton.disabled = true;
        resendButton.textContent = `Resend code in ${seconds}s`;
        setTimeout(updateResend, 1000);
      } else {
        resendButton.disabled = false;
        resendButton.textContent = 'Resend code';
      }
    }
    updateResend();
  </script>
</body>
</html>
