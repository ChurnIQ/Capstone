<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | ChurnIQ</title>
  <%- include('partials/auth-reset-styles') %>
</head>
<body>
  <main class="card">
    <h1>Create New Password</h1>
    <p class="sub">Choose a strong password you haven't used for this account.</p>

    <% if (error && error.length > 0) { %><div class="message error-msg"><%= error[0] %></div><% } %>
    <% if (success && success.length > 0) { %><div class="message success-msg"><%= success[0] %></div><% } %>

    <form action="/reset-password" method="POST" data-loading-form>
      <div class="form-group">
        <label for="password">New password</label>
        <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" required />
      </div>
      <div class="form-group">
        <label for="confirmPassword">Confirm new password</label>
        <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required />
      </div>
      <div class="rules">Use at least 8 characters with uppercase, lowercase, a number, and a special character.</div>
      <button class="btn btn-primary" type="submit" data-loading-text="Resetting password…">Reset password</button>
    </form>
  </main>
  <script>
    document.querySelector('[data-loading-form]').addEventListener('submit', function () {
      const button = this.querySelector('button[type="submit"]');
      button.disabled = true;
      button.textContent = button.dataset.loadingText;
    });
  </script>
</body>
</html>
